# ─── Exato One environment variables ────────────────────────────────────────
# Names and descriptions only. Never commit real values. On Vercel, set these
# in Project → Settings → Environment Variables (Production and Preview).

# Postgres connection for the APPLICATION role (exato_app: no BYPASSRLS, not
# table owner). Supabase: use the transaction pooler (port 6543) URL with the
# exato_app user. Row-level security is only enforced through this role.
DATABASE_URL=

# Postgres connection for MIGRATIONS (table owner, e.g. Supabase "postgres"
# direct connection on 5432). Used only by `npm run db:migrate`, never at runtime.
DATABASE_MIGRATION_URL=

# Public base URL of the deployment, used to build webhook endpoint URLs.
APP_URL=https://crm.example.com

# Shared secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>".
# Generate: openssl rand -base64 32
CRON_SECRET=

# 32 random bytes, base64. Encrypts integration credentials (AES-256-GCM).
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=
# Optional: previous key during rotation (decrypt-only).
ENCRYPTION_KEY_PREVIOUS=

# "true" lets anyone create a new workspace at /signup. Set "false" for a
# single-organisation production deployment after the first admin signs up.
ALLOW_SIGNUP=false

# Product name shown in the UI (public, non-secret).
NEXT_PUBLIC_APP_NAME=Exato One

# Max DB connections per server instance (keep low on serverless).
DB_POOL_MAX=5
